{
  "info": {
    "name": "Rate Limiter Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "metricsUrl",
      "value": "http://localhost:3001"
    }
  ],
  "item": [
    {
      "name": "Health & Metrics",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Redis is connected', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('ok');",
                  "  pm.expect(body.redis).to.eql('connected');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Metrics",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Contains rate limiter metrics', () => {",
                  "  pm.expect(pm.response.text()).to.include('rate_limiter_requests_total');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{metricsUrl}}/metrics"
          }
        }
      ]
    },
    {
      "name": "Fixed Window",
      "item": [
        {
          "name": "Fixed Window — Allowed",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Request allowed', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.allowed).to.eql(true);",
                  "  pm.expect(body.algorithm).to.eql('fixed-window');",
                  "  pm.expect(body.remaining).to.be.a('number');",
                  "  pm.expect(body.resetAt).to.be.a('number');",
                  "  pm.expect(body.traceId).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/check",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"test:fixed\",\n  \"algorithm\": \"fixed-window\",\n  \"limit\": 5,\n  \"window\": 60\n}"
            }
          }
        },
        {
          "name": "Fixed Window — Rejected (run 6 times)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 or 429', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 429]);",
                  "});",
                  "pm.test('Response has retryAfter when rejected', () => {",
                  "  const body = pm.response.json();",
                  "  if (!body.allowed) {",
                  "    pm.expect(body.retryAfter).to.be.a('number');",
                  "    pm.expect(body.remaining).to.eql(0);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/check",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"test:fixed\",\n  \"algorithm\": \"fixed-window\",\n  \"limit\": 5,\n  \"window\": 60\n}"
            }
          }
        }
      ]
    },
