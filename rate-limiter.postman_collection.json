                  "    pm.expect(body.remaining).to.eql(0);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/check",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"test:token\",\n  \"algorithm\": \"token-bucket\",\n  \"limit\": 5,\n  \"window\": 60\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Trace Propagation",
      "item": [
        {
          "name": "Trace Propagation — Custom traceId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('traceId matches sent header', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.traceId).to.eql('my-custom-trace-123');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-trace-id", "value": "my-custom-trace-123" }
            ],
            "url": "{{baseUrl}}/check",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"test:trace\",\n  \"algorithm\": \"token-bucket\",\n  \"limit\": 5,\n  \"window\": 60\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Validation",
      "item": [
        {
          "name": "Validation — Invalid Algorithm",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', () => {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Validation error response', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error).to.eql('Validation failed');",
                  "  pm.expect(body.details).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/check",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"test\",\n  \"algorithm\": \"invalid-algo\",\n  \"limit\": 5,\n  \"window\": 60\n}"
            }
          }
        },
        {
          "name": "Validation — Missing Algorithm",
          "event": [
            {
              "listen": "test",
