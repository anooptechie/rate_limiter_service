            "url": "{{baseUrl}}/check",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"test:sliding\",\n  \"algorithm\": \"sliding-window\",\n  \"limit\": 5,\n  \"window\": 60\n}"
            }
          }
        }
      ]
    },
